<html>
<head>
    <meta charset="utf-8" />
    <style>

        body {
            font-family: Segoe UI, Arial, sans-serif;
            margin: 0;
            padding: 10px;
            background-color: transparent;
        }

        .updater-wrapper {
            position: relative;
            max-width: 300px;
        }

        .updater-container {
            background: #f9f9f9;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            width: 300px;
            transition: filter 0.3s ease;
            text-align: center;
        }

            .updater-container.blurred {
                filter: blur(1.2px) brightness(0.97);
            }

        .form-row {
            margin-bottom: 10px;
        }

            .form-row label {
                display: block;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .form-row input {
                width: 100%;
                padding: 6px;
                border: 1px solid #ccc;
                border-radius: 4px;
            }

        button {
            background-color: #0078d4;
            color: #fff;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 4px;
            cursor: pointer;
        }
        .spinner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    z-index: 10;
    align-items: center;
    justify-content: center;
    display: none; /* keep this last so it's respected */
}

        .spinner {
            width: 32px;
            height: 32px;
            border: 4px solid #ccc;
            border-top: 4px solid #0078d4;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        #progress {
            font-size: 13px;
            text-align: center;
            margin-top: 8px;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="updater-wrapper">
        <div id="overlay" class="spinner-overlay">
            <div class="spinner"></div>
        </div>

        <div id="container" class="updater-container">
            <div class="form-row">
                <label for="inputValue">Påslag:</label>
                <input type="text" id="inputValue" placeholder="Enter påslag value to update" />
            </div>
            <button onclick="confirmAndUpdate()">Oppdater</button>
            <div id="progress"></div>
        </div>
    </div>
    <script>
        let parentXrm = window.parent.Xrm || Xrm;

        function confirmAndUpdate() {
            const inputValue = document.getElementById("inputValue").value;
            if (!inputValue) {
                parentXrm.Navigation.openAlertDialog({ text: "Please enter a påslag value." });
                return;
            }

            parentXrm.Navigation.openConfirmDialog({
                title: "Confirm Oppdatere påslag",
                text: "Are you sure you want to set påslag to '" + inputValue + "%' for all related child records?"
            }).then(function (result) {
                if (result.confirmed) {
                    updateRecords(parseFloat(inputValue));
                }
            });
        }

        function updateRecords(value) {
            debugger;
            const overlay = document.getElementById("overlay");
            const container = document.getElementById("container");
            const progress = document.getElementById("progress");

            overlay.style.display = "flex";
            container.classList.add("blurred");
            progress.innerText = "Fetching records...";

            const recordId = parentXrm.Page.data.entity.getId().replace(/[{}]/g, "");
            parentXrm.WebApi.retrieveMultipleRecords("sl_purchasecalculations", `?$select=sl_purchasecalculationsid,sl_name,sl_surcharge&$expand=sl_lookupprojectpurchase($select=sl_projectpurchaseid)&$filter=sl_surcharge gt 0 and sl_lookupprojectpurchase/_sl_projectreference_project_value eq ${recordId}`).then(result => {
                const total = result.entities.length;
                let completed = 0;

                if (total === 0) {
                    overlay.style.display = "none";
                    container.classList.remove("blurred");
                    progress.innerText = "No related records found.";
                    return;
                }

                progress.innerText = `Updating ${total} records...`;

                result.entities.forEach(entity => {
                    parentXrm.WebApi.updateRecord("sl_purchasecalculations", entity.sl_purchasecalculationsid, { sl_surcharge: value }).then(() => {
                        completed++;
                        progress.innerText = `Updated ${completed} of ${total}`;
                        if (completed === total) {
                            overlay.style.display = "none";
                            container.classList.remove("blurred");
                            progress.innerText = "✅ All records updated successfully.";
                        }
                    }).catch(err => {
                        overlay.style.display = "none";
                        container.classList.remove("blurred");
                        progress.innerText = "❌ Error updating records.";
                        console.error(err);
                    });
                });
            });
        }
    </script>
</body>
</html>