function onMultiSelectChange(executionContext) {
    const formContext = executionContext.getFormContext();
    const moField = formContext.getAttribute("sl_discipline");

    // Ensure the field is not null before calling getSelectedOption()
    if (!moField) return;

    // Returns an array of selected OptionSet values or null
    const selectedOptions = moField.getSelectedOption();

    // Check if selectedOptions is null or empty
    if (!selectedOptions || selectedOptions.length === 0) {
        // No options selected, handle NULL case
        formContext.getControl("sl_konsulentereksterne").setVisible(false);
        formContext.getAttribute("sl_konsulentereksterne").setRequiredLevel("none");
        return;
    }

    // Check if the specific value (102690002) is selected
    if (selectedOptions.some(i => i.value === 102690002)) {
        // Show mobile phone field
        formContext.getControl("sl_konsulentereksterne").setVisible(true);
        formContext.getAttribute("sl_konsulentereksterne").setRequiredLevel("recommended");
    } else {
        // Hide mobile phone field
        formContext.getControl("sl_konsulentereksterne").setVisible(false);
        formContext.getAttribute("sl_konsulentereksterne").setRequiredLevel("none");
        formContext.getAttribute("sl_konsulentereksterne").setValue(null);
    }
}
